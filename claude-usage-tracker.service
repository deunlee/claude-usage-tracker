[Unit]
Description=Claude usage tracker

[Service]
# 수집할 ~/.claude의 주인으로 돌린다. User=를 주면 systemd가 HOME도 이 사용자의 홈으로 넣어 ~/.claude를 찾는다.
User=ubuntu

# 설치 폴더에 맞게 고친다. amd64면 cut-linux-amd64.
# config.json, archive/, logs/를 이 실행 파일 옆에 두므로 그 폴더에 쓸 수 있어야 한다.
# 시스템 매니저의 %h는 User=와 상관없이 /root라 절대 경로로 적는다.
ExecStart=/home/ubuntu/claude-usage-tracker/cut-linux-arm64

# 토큰이 만료되면 /bin/sh로 claude를 실행하는데, 서비스의 기본 PATH에는 네이티브 설치 위치(~/.local/bin)가
# 없다. claude를 다른 곳에 설치했으면 `command -v claude`가 가리키는 폴더를 넣는다.
Environment=PATH=/home/ubuntu/.local/bin:/usr/local/bin:/usr/bin:/bin

# 설정 오류나 포트 충돌로 끝나면 다시 띄운다. 수집할 계정이 없어 정상 종료(0)한 경우는 그대로 둔다.
Restart=on-failure
RestartSec=30s

# ~/.claude와 실행 폴더를 써야 해서 파일 시스템을 가리는 옵션은 넣지 않는다.
NoNewPrivileges=yes
# logs/와 archive/에 이메일과 사용량이 남으므로 같은 머신의 다른 사용자가 읽지 못하게 한다.
UMask=0077

[Install]
WantedBy=multi-user.target
